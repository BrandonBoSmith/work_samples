# Copy to .env and fill in.

# OpenAI-compatible embeddings endpoint (OpenAI, vLLM, Ollama, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-ai-api-key
EMBED_MODEL=text-embedding-3-small

# Cross-encoder reranker (downloaded locally on first use; runs on-box)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Vector store + corpus
CHROMA_PATH=./chroma
COLLECTION_NAME=knowledge_base
DATA_DIR=./data

# Chunking + retrieval knobs
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
FETCH_K=20

# Optional: set to anything to enable DEBUG logging
# DEBUG=1
