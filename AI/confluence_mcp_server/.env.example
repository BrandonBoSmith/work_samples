# Copy to .env and fill in. Unlike the agent sample, this server has no model
# and no AI API key -- the LLM lives in whichever MCP client connects to it.

# Confluence Cloud configurations
CONFLUENCE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USER=you@example.com
CONFLUENCE_API_KEY=your-confluence-api-token
SEARCH_LIMIT=5

# Transport: stdio (default, launched by a desktop client) or streamable-http
# (network service). MCP_HOST / MCP_PORT apply only to streamable-http.
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# Optional: set to anything to enable DEBUG logging (logs go to stderr)
# DEBUG=1
