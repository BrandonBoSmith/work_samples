# Copy to .env and fill in. The AI endpoint's model must support function/tool calling.

# Confluence Cloud configurations
CONFLUENCE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USER=you@example.com
CONFLUENCE_API_KEY=your-confluence-api-token
SEARCH_LIMIT=5

# OpenAI-compatible inference endpoint (OpenAI, vLLM, Ollama, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-ai-api-key
MODEL=gpt-4o-mini
MAX_AGENT_STEPS=5

# Optional: set to anything to enable DEBUG logging (shows tool calls/results)
# DEBUG=1
